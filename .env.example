# Copy to .env (chmod 600). Values for local development come from `npx supabase status -o env`.

# Supabase API URL (local default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase *publishable* key. Safe for the browser: every table is protected by row-level security.
# Never put the secret / service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL of the app, used to build auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

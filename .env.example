# Copy to .env (chmod 600). Values for local development come from `npx supabase status -o env`.

# Supabase API URL (local default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase *publishable* key. Safe for the browser: every table is protected by row-level security.
# Never put the secret / service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Base URL of the app, used to build auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mapbox *public* token (starts with pk.). Restrict it to http://localhost:3000 in your Mapbox
# account. Without it the app runs, but maps show a notice instead.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Server only (never NEXT_PUBLIC_) -------------------------------------------------------------
# Gemini API key from Google AI Studio. Without it, Compass falls back to non-AI ranking.
GEMINI_API_KEY=
# Main model, and the model tried once if the main one is overloaded or rate-limited.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# AI requests each traveller may make per day.
AI_DAILY_LIMIT=30

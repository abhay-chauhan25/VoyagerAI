{
  "name": "voyager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "test:db": "supabase test db",
    "data:cities": "node scripts/data/load-cities.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@google/genai": "2.30.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "mapbox-gl": "3.33.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "opening_hours": "3.15.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "i18next": "26.5.3"
  }
}
